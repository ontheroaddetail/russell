# Google service account email (e.g. otr-bookings@my-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key. Paste the full -----BEGIN PRIVATE KEY-----... string
# from the downloaded JSON, with newlines escaped as \n. Wrap the whole value in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The ID of the Google Sheet that stores bookings (the long string in the sheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# The Google Calendar ID where booking events should be created (e.g. abc@group.calendar.google.com)
GOOGLE_CALENDAR_ID=
